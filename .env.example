# TDX (Transport Data eXchange) — Phase 3 live traffic
# Copy this file to `.env.local`. Leave empty to use bundled MOCK traffic
# and CCTV SNAPSHOT. Do not commit real secrets.
#
# Server-only. Never prefix these with NEXT_PUBLIC_ — the client secret
# must not ship to the browser.
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# 建物門牌優先使用國土測繪圖資服務雲公開 TextQueryMap（免金鑰）。
# 下列 TGOS 全國門牌為選用後備；未設定時仍走國土測量雲 + OSM。
TGOS_APP_ID=
TGOS_API_URL=
TGOS_API_KEY=

# 內政主題 API「測速執法設置點」（選填、伺服器端）
# 未設定時會直接使用警政署政府資料開放平臺的免金鑰 CSV。
TGOS_THEME_API_KEY=

# NLSC：預設使用公開 TextQueryMap。可選填自訂端點；金鑰不得加 NEXT_PUBLIC_。
NLSC_API_URL=
NLSC_API_KEY=

# NCDR 民生示警公開資料（選填、伺服器端）
NCDR_API_KEY=
NCDR_ALERT_FEED_URL=

# OpenAI / ChatGPT 導航語音（選填、伺服器端）
OPENAI_API_KEY=

# Google 登入（OAuth Client ID，可給前端）
# 設定方式見 docs/google-oauth-setup.md
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Places／Geocoding：MapLibre 模式不使用。即使填了也不會啟用。
# 禁止 NEXT_PUBLIC_。與 NEXT_PUBLIC_GOOGLE_CLIENT_ID（OAuth 登入）完全不同。
GOOGLE_PLACES_API_KEY=

# Supabase 地址快取。SERVICE_ROLE 只能放 Server，禁止 NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
