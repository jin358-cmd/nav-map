# TDX (Transport Data eXchange) — Phase 3 live traffic
# Copy this file to `.env.local`. Leave empty to use bundled MOCK traffic
# and CCTV SNAPSHOT. Do not commit real secrets.
#
# Prefer server-side vars so the client secret never ships to the browser.
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# Optional aliases. NEXT_PUBLIC_TDX_CLIENT_SECRET will leak to the client —
# use the TDX_* pair above whenever possible.
NEXT_PUBLIC_TDX_CLIENT_ID=
NEXT_PUBLIC_TDX_CLIENT_SECRET=
