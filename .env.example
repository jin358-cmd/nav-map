# TDX (Transport Data eXchange) — 即時路況、事故、施工、停車場
# Copy this file to `.env.local`. 未設定時正式環境顯示「資料暫時無法取得」，
# 不會自動填入假路況或假事故。Do not commit real secrets.
#
# Server-only. Never prefix these with NEXT_PUBLIC_ — the client secret
# must not ship to the browser.
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# 建物門牌優先使用國土測繪圖資服務雲公開 TextQueryMap（免金鑰）。
# 下列 TGOS 全國門牌為選用後備；未設定時仍走國土測量雲 + OSM。
TGOS_APP_ID=
TGOS_API_URL=
TGOS_API_KEY=

# 內政主題 API「測速執法設置點」（選填、伺服器端）
# 未設定時會直接使用警政署政府資料開放平臺的免金鑰 CSV。
TGOS_THEME_API_KEY=

# NLSC：預設使用公開 TextQueryMap。可選填自訂端點；金鑰不得加 NEXT_PUBLIC_。
NLSC_API_URL=
NLSC_API_KEY=

# NCDR 民生示警公開資料（選填、伺服器端）
NCDR_API_KEY=
NCDR_ALERT_FEED_URL=

# 機車路線預設走 Valhalla motorcycle，並避開國道／快速道路。
# 可改成自架 Valhalla /route 端點。公開 OSRM 不支援 exclude=motorway，不要填 driving。
# 禁止用腳踏車 profile 冒充機車。禁止 NEXT_PUBLIC_。
MOTORCYCLE_ROUTING_URL=
VALHALLA_ROUTING_URL=

# OpenAI / ChatGPT 導航語音（選填、伺服器端）
OPENAI_API_KEY=

# 僅本機／開發示範。Production 必須保持空白或 0。
# 設為 1 時才會顯示標示為「示範資料」的測試圖層。
NEXT_PUBLIC_ENABLE_DEMO=

# Google 登入（OAuth Web Client ID，可給前端）
# 設定方式見 docs/google-oauth-setup.md
# 擇一即可：NEXT_PUBLIC_GOOGLE_CLIENT_ID 會打進前端；GOOGLE_CLIENT_ID 由伺服器
# /api/auth/google-config 提供（OAuth Client ID 本來就是公開值，不是 Secret）。
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Google Places／Geocoding：MapLibre 模式不使用。即使填了也不會啟用。
# 禁止 NEXT_PUBLIC_。與 NEXT_PUBLIC_GOOGLE_CLIENT_ID（OAuth 登入）完全不同。
GOOGLE_PLACES_API_KEY=

# Supabase 地址快取、taiwan_poi_index 與停車場 Open Data。SERVICE_ROLE 只能放 Server，禁止 NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 停車場同步（選填）。設定後 POST /api/parking/sync 需帶 x-parking-sync-key。
PARKING_SYNC_KEY=

# POI 索引同步（選填）。設定後 POST /api/pois/sync 需帶 x-poi-sync-key。
POI_SYNC_KEY=
