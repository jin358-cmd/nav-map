# TDX (Transport Data eXchange) — Phase 3 live traffic
# Copy this file to `.env.local`. Leave empty to use bundled MOCK traffic
# and CCTV SNAPSHOT. Do not commit real secrets.
#
# Server-only. Never prefix these with NEXT_PUBLIC_ — the client secret
# must not ship to the browser.
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# 建物門牌優先使用國土測繪圖資服務雲公開 TextQueryMap（免金鑰）。
# 下列 TGOS 全國門牌為選用後備；未設定時仍走國土測量雲 + OSM。
TGOS_APP_ID=
TGOS_API_KEY=

# 內政主題 API「測速執法設置點」（選填、伺服器端）
# 未設定時會直接使用警政署政府資料開放平臺的免金鑰 CSV。
TGOS_THEME_API_KEY=

# NCDR 民生示警公開資料（選填、伺服器端）
# 未設定時使用免金鑰 JSONAtomFeed。會員 API Key 可改走 webapi，
# 取得較完整的地方政府示警；失敗仍回落到公開 feed，再失敗才用 mock。
NCDR_API_KEY=

# NCDR 民生示警 JSON Atom Feed（可留空使用官方預設網址）
NCDR_ALERT_FEED_URL=

# OpenAI / ChatGPT 導航語音（選填、伺服器端）
# 未設定時改用瀏覽器 zh-TW 語音合成，不阻擋導航。
OPENAI_API_KEY=

# Google 登入、書籤寫入個人 Google 帳號、YouTube Music 歌單（選填）
# 未設定時底部「Google 登入」仍可點，會提示需設定 Client ID；書籤只留在此裝置。
# Google Cloud Console → OAuth 2.0 網頁用戶端：
# 1. 啟用 Google Drive API、YouTube Data API v3
# 2. 授權 JavaScript 來源：本機 http://127.0.0.1:43145；正式站為你的網域
# 3. 授權重新導向 URI 可留空（使用 GIS token client 彈出視窗）
# 4. 範圍：openid email profile、drive.appdata、youtube.readonly
# 書籤存在該帳號的 Drive 應用程式資料夾（navpilot-bookmarks.json），不會出現在雲端硬碟清單。
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
